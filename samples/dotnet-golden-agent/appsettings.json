{
  "Agent": {
    "Name": "AGIC-Agent365-GoldenAgent",
    "Provider": "foundry-local",
    "Model": "",
    "FoundryLocalEndpoint": "http://127.0.0.1:39839/v1",
    "AzureOpenAIEndpoint": "",
    "Instructions": "You are the AGIC Agent 365 golden sample. Be concise, factual and operational. Use available tools when useful. The change-request tool creates a mock draft only."
  },
  "Agent365": {
    "ExportToConsole": true,
    "ExportToAgent365": false,
    "AgentId": "",
    "TenantId": "",
    "ClientSecret": ""
  },
  "Api": {
    "RequireApiKey": false,
    "ApiKey": "",
    "RequestsPerMinute": 30,
    "MaxMessageCharacters": 8000,
    "MaxConversationIdCharacters": 128
  },
  "Conversations": {
    "MaxConversations": 200,
    "IdleTimeoutMinutes": 30
  },
  "Tools": {
    "EnablePolicyLookup": true,
    "EnableDraftChangeRequest": true,
    "RequireApprovalForDraftChangeRequest": false,
    "AllowRuntimePolicyChanges": true,
    "ApprovalTtlMinutes": 5,
    "AuditCapacity": 500
  },
  "Evidence": {
    "Enabled": true,
    "Capacity": 500
  },
  "Reliability": {
    "WindowRuns": 50,
    "MinimumRuns": 5,
    "FailureRateWarning": 0.10,
    "FailureRateCritical": 0.25,
    "AverageLatencyWarningMs": 2500,
    "AverageLatencyCriticalMs": 5000,
    "ToolDenyRateWarning": 0.15,
    "ToolDenyRateCritical": 0.30,
    "ConsecutiveFailuresCritical": 3
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.OpenTelemetry": "Information"
    }
  }
}
