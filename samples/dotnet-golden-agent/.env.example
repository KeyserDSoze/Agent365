# Default local runtime
Agent__Provider=foundry-local
Agent__FoundryLocalEndpoint=http://127.0.0.1:39839/v1
# Set by scripts/start-foundry-local.ps1 after resolving the selected alias.
Agent__Model=
Agent__Name=AGIC-Agent365-GoldenAgent

# Optional Azure OpenAI fallback
Agent__AzureOpenAIEndpoint=https://YOUR-RESOURCE.openai.azure.com/

# Agent 365 observability
Agent365__ExportToConsole=true
Agent365__ExportToAgent365=false

# Custom-engine S2S mode.
# AgentId MUST be the Client ID of the standard Entra app registration used for export.
Agent365__AgentId=
Agent365__TenantId=
Agent365__ClientSecret=

# Optional verbose exporter diagnostics
A365_OBSERVABILITY_LOG_LEVEL=info

# Optional POC hardening
Api__RequireApiKey=false
Api__ApiKey=
Api__RequestsPerMinute=30
Api__MaxMessageCharacters=8000
Api__MaxConversationIdCharacters=128

# In-memory session guardrails
Conversations__MaxConversations=200
Conversations__IdleTimeoutMinutes=30

# Tool governance
Tools__EnablePolicyLookup=true
Tools__EnableDraftChangeRequest=true
Tools__RequireApprovalForDraftChangeRequest=false
Tools__AllowRuntimePolicyChanges=true
Tools__ApprovalTtlMinutes=5
Tools__AuditCapacity=500

# Privacy-safe run evidence: metadata only, no prompt/response content
Evidence__Enabled=true
Evidence__Capacity=500
